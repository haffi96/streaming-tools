        {"expr": "histogram_quantile(0.95, sum by (le, track_name) (rate({__name__=~\"livekit_publisher_frame_publish_duration.*bucket\",room=~\"$room\",track_name=~\"$track\"}[30s])))", "legendFormat": "p95 {{track_name}}"},
        {"expr": "histogram_quantile(0.99, sum by (le, track_name) (rate({__name__=~\"livekit_publisher_frame_publish_duration.*bucket\",room=~\"$room\",track_name=~\"$track\"}[30s])))", "legendFormat": "p99 {{track_name}}"}
