  "panels": [
    {
      "title": "TCP frames consumed (FPS)", "type": "timeseries", "id": 1,
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 0},
      "targets": [{"expr": "sum by (track_name, video_quality) (rate({__name__=~\"livekit_publisher_frames_consumed.*total\",room=~\"$room\",participant_identity=~\"$identity\",track_name=~\"$track\",codec=~\"$codec\",video_quality=~\"$quality\"}[30s]))", "legendFormat": "{{track_name}} {{video_quality}}"}],
      "fieldConfig": {"defaults": {"unit": "fps"}, "overrides": []}
    },
    {
      "title": "Frames published (FPS)", "type": "timeseries", "id": 2,
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 0},
      "targets": [{"expr": "sum by (track_name, video_quality) (rate({__name__=~\"livekit_publisher_frames_published.*total\",room=~\"$room\",participant_identity=~\"$identity\",track_name=~\"$track\",codec=~\"$codec\",video_quality=~\"$quality\"}[30s]))", "legendFormat": "{{track_name}} {{video_quality}}"}],
      "fieldConfig": {"defaults": {"unit": "fps"}, "overrides": []}
    },
    {
      "title": "Track health", "type": "stat", "id": 3,
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 0},
      "targets": [{"expr": "sum by (track_name) (rate({__name__=~\"livekit_publisher_frames_published.*total\",room=~\"$room\",participant_identity=~\"$identity\",track_name=~\"$track\"}[30s]))", "legendFormat": "{{track_name}}"}],
      "fieldConfig": {"defaults": {"unit": "fps", "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}}, "overrides": []}
    },
    {
      "title": "Consumed vs published FPS", "type": "timeseries", "id": 4,
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "targets": [
        {"expr": "sum(rate({__name__=~\"livekit_publisher_frames_consumed.*total\",room=~\"$room\",participant_identity=~\"$identity\",track_name=~\"$track\"}[30s]))", "legendFormat": "consumed"},
        {"expr": "sum(rate({__name__=~\"livekit_publisher_frames_published.*total\",room=~\"$room\",participant_identity=~\"$identity\",track_name=~\"$track\"}[30s]))", "legendFormat": "published"}
      ],
      "fieldConfig": {"defaults": {"unit": "fps"}, "overrides": []}
    },
    {
      "title": "Frame size quantiles", "type": "timeseries", "id": 5,
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "targets": [
        {"expr": "histogram_quantile(0.50, sum by (le, track_name) (rate({__name__=~\"livekit_publisher_frame_size.*bucket\",room=~\"$room\",track_name=~\"$track\"}[30s])))", "legendFormat": "p50 {{track_name}}"},
        {"expr": "histogram_quantile(0.95, sum by (le, track_name) (rate({__name__=~\"livekit_publisher_frame_size.*bucket\",room=~\"$room\",track_name=~\"$track\"}[30s])))", "legendFormat": "p95 {{track_name}}"},
        {"expr": "histogram_quantile(0.99, sum by (le, track_name) (rate({__name__=~\"livekit_publisher_frame_size.*bucket\",room=~\"$room\",track_name=~\"$track\"}[30s])))", "legendFormat": "p99 {{track_name}}"},
        {"expr": "sum by (track_name) (rate({__name__=~\"livekit_publisher_frame_size.*sum\",room=~\"$room\",track_name=~\"$track\"}[30s])) / sum by (track_name) (rate({__name__=~\"livekit_publisher_frame_size.*count\",room=~\"$room\",track_name=~\"$track\"}[30s]))", "legendFormat": "avg {{track_name}}"}
      ],
      "fieldConfig": {"defaults": {"unit": "bytes"}, "overrides": []}
    },
    {
